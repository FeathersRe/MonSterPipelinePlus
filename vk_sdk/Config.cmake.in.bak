@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CapnProto 1.0.2 CONFIG REQUIRED)
find_dependency(eCAL 5.11.8 CONFIG REQUIRED)

add_library(ixwebsocket::ixwebsocket SHARED IMPORTED GLOBAL)
set_target_properties(ixwebsocket::ixwebsocket PROPERTIES 
    IMPORTED_LOCATION ${CMAKE_CURRENT_LIST_DIR}/../../${CMAKE_STATIC_LIBRARY_PREFIX}ixwebsocket${CMAKE_STATIC_LIBRARY_SUFFIX})

include("${CMAKE_CURRENT_LIST_DIR}/vk_sdkTargets.cmake")

check_required_components(vk_sdk)